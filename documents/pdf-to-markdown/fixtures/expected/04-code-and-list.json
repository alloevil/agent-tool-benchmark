  "code_lines": [
    "def moving_average(xs, k):",
    "    if k <= 0:",
    "        raise ValueError(\"window must be positive\")",
    "    acc = 0.0",
    "    out = []",
    "    for i, x in enumerate(xs):",
    "        acc += x",
    "        if i >= k:",
    "            acc -= xs[i - k]",
    "        out.append(acc / min(i + 1, k))",
    "    return out"
  ]
}
